# optional parameters
0.1645        XEFCLTEF       
10.53         MAXCLTEF       
# nitrification/denitrification function defaults
# optional parameters
#   cNsoilt(1:4) =(35.1, -5.1, 4.51, 7.1)           use default temperature effect parameters
#   cNph(1:4)    =(5.1, 0.561, 1.1, 0.461)          use default ph parameters
#   cNwfps(1:2)  =(30.1, -9.1)                      use default Water Filled Pore Space exponential
#   cDno3(1:4)   =(9.231, 1.5561, 76.911, 0.002221) use default Nitrate effect on Denitrification
# Methane parameters
-1            FLDN2D         # FLooDed N2/N2O ratio Delay (-1 disable)
100.0         FLN2OR         # flood_N2toN2O  # N2/N2O ratio for flooded state (100.0) (-1 disable)
0.50          CO2CH4         # fraction of CO2 from soil respiration used to produce CH4 (.15)
0.65          MXCH4F         # MaXimum CH4 Fraction (.55)
0.55          FREXUD         # FRaction EXUDates; root production fraction released as exudate (.45)
0.23          AEH            # differential coefficient (Aeh)
0.16          DEH            # differential coefficient (Deh)
-250.         BEHFL          # low-limit value for Eh during flooding course (mv)
300.          BEHDR          # upper-limit value of Eh during drainage course (mv)
0.7           METHZR         # fraction CH4 emitted via bubbles with zero root biomass (0.0-1.0)
14            WFDRYT         # water pulse function drying delay
# freeze pulse
# M5: --TPL 3 --PFT -100,180,2 --PDS 0.7,100,180 --ntrrd 3
#  TNP; duration: tplen= 3
#  TNP; freezing degree day pulse length plmfdd= 100.000, plxfdd= 180.000 triggering on lyr 2
#  TNP; freezing degree day sum NOT RESET on pulse
#  TNP; denitrification pore space inflection tnpsif= 0.800
#  TNP; frozen degree day denitrification pore space shift limits dpsfdm= 100.000, dpsfdx= 180.000
#  TNP; remove denitrification respiration restraint above layer 3
3             TPLEN          # Thaw N Freeze Thaw Period in days
-100.0        PLMFDD         # Pulse Length Minimum Freezing Degree Day
180.0         PLXFDD         # Pulse Length maXimum Freezing Degree Day
2             PTRLYR         # soil layer to sample for trigger
0.7           TNPSIF         # Pore Space x_inflection shift Factor */
100.0         DPSFDM         # denitrification pore space frozen degree minimum
180.0         DPSFDX         # denitrification pore space frozen degree maximum
3             TNDRRL         # remove denitrification respiration restraint above layer
#5.0          TNSAD          # minimum Snow Arm Depth
#-0.6         TNSTD          # snow pack needed to trigger pulse (<x or x loss)
#! 0          TNSATF         # pulse N2N2O saturated fraction
